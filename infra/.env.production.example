# Server-side environment for infra/docker-compose.prod.yml. Copy to /opt/vpyd/.env.production on the VPS,
# fill in, then: chmod 600 .env.production (owner deploy). NEVER commit the real file, never paste values in chat.
# Values with special characters in URLs (passwords) must be percent-encoded.

# --- Images (built by .github/workflows/deploy.yml, pushed to GHCR) -------------------------------------
API_IMAGE=            # ghcr.io/<owner>/vpyd-api:<git-sha>
WEB_IMAGE=            # ghcr.io/<owner>/vpyd-web:<git-sha>
BACKUP_IMAGE=         # ghcr.io/<owner>/vpyd-backup:<git-sha>

# --- Public site -------------------------------------------------------------------------------------------
DOMAIN=               # e.g. staging.<your-domain> — DNS A/AAAA record must point at the VPS before first start
ACME_EMAIL=           # Let's Encrypt expiry notices
APP_ENV=staging       # staging | production (both require an https origin; the API derives it from DOMAIN)
RUST_LOG=info

# --- Database (Supabase, ADR-0002) ------------------------------------------------------------------------
# Staging project ref: zyyiukcysjntjgjabiqe (project vpyd-staging, US region; production = new Singapore project). Copy the exact pooler host from
# Dashboard > Connect: aws-<index>-<region>.pooler.supabase.com (index and region cannot be derived).
# Use the Supavisor SESSION pooler (port 5432, IPv4, user <role>.<ref>) or the direct host
# db.zyyiukcysjntjgjabiqe.supabase.co:5432 (IPv6 only unless the IPv4 add-on is bought; user without suffix).
# NOT the transaction pooler (6543): SQLx uses prepared statements. TLS is verified with the Supabase CA:
#   ...?sslmode=verify-full&sslrootcert=/run/secrets/supabase-ca.crt
# Owner role (postgres) — used ONLY by the one-shot `migrate` job:
MIGRATE_DATABASE_URL= # postgres://postgres.zyyiukcysjntjgjabiqe:<pw>@aws-<index>-<region>.pooler.supabase.com:5432/postgres?sslmode=verify-full&sslrootcert=/run/secrets/supabase-ca.crt
# Runtime role app_rw (no BYPASSRLS) — the only credential the long-running API holds:
APP_DATABASE_URL=     # postgres://app_rw.zyyiukcysjntjgjabiqe:<pw>@aws-<index>-<region>.pooler.supabase.com:5432/postgres?sslmode=verify-full&sslrootcert=/run/secrets/supabase-ca.crt

# --- Field encryption (health notes, S5) ------------------------------------------------------------------
# 32 random bytes, base64: `openssl rand -base64 32`. Losing it makes encrypted notes unreadable: keep an
# offline copy (password manager) SEPARATE from the database backups. Never rotate by just replacing it.
APP_DATA_KEY=

# --- Backup (infra/backup) ---------------------------------------------------------------------------------
# libpq connection for pg_dump (owner role: it must read every app table, RLS bypassed as table owner).
BACKUP_PGHOST=        # same pooler host (session mode) or direct host
BACKUP_PGPORT=5432
BACKUP_PGUSER=        # postgres.zyyiukcysjntjgjabiqe (session pooler) or postgres (direct host)
BACKUP_PGPASSWORD=
BACKUP_PGDATABASE=postgres
BACKUP_PGSSLMODE=verify-full
AGE_RECIPIENT=        # age public key (age1...). The matching private key stays OFFLINE with the EM.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=     # R2 API token: Object Read & Write, THIS bucket only. R2 has no write-only token, so deletion
                      # is blocked by bucket lock rules (runbook §R2), not by the token. Never an Admin token.
R2_SECRET_ACCESS_KEY=
R2_BUCKET=            # e.g. vpyd-backups
BACKUP_PREFIX=staging
# Retention: no variable here on purpose. Expiry = R2 lifecycle rules, protection = R2 bucket lock rules, both
# managed only from the Cloudflare dashboard (EM account, 2FA). The VPS never deletes a finished backup.
BACKUP_HEALTHCHECK_PING_URL=    # https://hc-ping.com/<uuid> (healthchecks.io free tier) — alerts if a night is missed

# --- Optional ----------------------------------------------------------------------------------------------
SECRETS_DIR=../secrets          # relative to infra/: holds supabase-ca.crt (and age-identity.txt only during a drill)
HTTP_PORT=80
HTTPS_PORT=443

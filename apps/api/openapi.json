  "components": {
    "schemas": {
      "CategoryCreate": {
        "type": "object",
        "required": [
          "name"
        ],
        "properties": {
          "name": {
            "type": "string"
          }
        },
        "additionalProperties": false
      },
      "CategoryUpdate": {
        "type": "object",
        "required": [
          "name",
          "sort_order"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "sort_order": {
            "type": "integer",
            "format": "int32"
          }
        },
        "additionalProperties": false
      },
      "CustomerCreate": {
        "type": "object",
        "required": [
          "full_name",
          "phone"
        ],
        "properties": {
          "address": {
            "type": [
              "string",
              "null"
            ]
          },
          "birth_year": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int32"
          },
          "full_name": {
            "type": "string"
          },
          "gender": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/GenderDto"
              },
              {
                "type": "null"
              }
            ]
          },
          "health_note": {
            "type": [
              "string",
              "null"
            ],
            "description": "Requires `customer.health_notes.write`."
          },
          "note": {
            "type": [
              "string",
              "null"
            ]
          },
          "phone": {
            "type": "string"
          },
          "source": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "additionalProperties": false
      },
      "CustomerDto": {
        "type": "object",
        "required": [
          "id",
          "full_name",
          "phone",
          "phone_e164",
          "version",
          "created_at"
        ],
        "properties": {
          "address": {
            "type": [
              "string",
              "null"
            ]
          },
          "birth_year": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int32"
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "full_name": {
            "type": "string"
          },
          "gender": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/GenderDto"
              },
              {
                "type": "null"
              }
            ]
          },
          "health_note": {
            "type": [
              "string",
              "null"
            ],
            "description": "Present only for callers with `customer.health_notes.read`; null = no note."
          },
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "note": {
            "type": [
              "string",
              "null"
            ]
          },
          "phone": {
            "type": "string"
          },
          "phone_e164": {
            "type": "string"
          },
          "source": {
            "type": [
              "string",
              "null"
            ]
          },
          "version": {
            "type": "integer",
            "format": "int64",
            "description": "Send back as `If-Match` when updating."
          }
        }
      },
      "CustomerSummaryDto": {
        "type": "object",
        "description": "Search hit for the counter: never contains notes.",
        "required": [
          "id",
          "full_name",
          "phone"
        ],
        "properties": {
          "full_name": {
            "type": "string"
          },
          "gender": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/GenderDto"
              },
              {
                "type": "null"
              }
            ]
          },
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "phone": {
            "type": "string",
            "description": "National display form, e.g. \"0905 123 456\"."
          }
        }
      },
      "CustomerUpdate": {
        "type": "object",
        "required": [
          "full_name",
          "phone"
        ],
        "properties": {
          "address": {
            "type": [
              "string",
              "null"
            ]
          },
          "birth_year": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int32"
          },
          "full_name": {
            "type": "string"
          },
          "gender": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/GenderDto"
              },
              {
                "type": "null"
              }
            ]
          },
          "note": {
            "type": [
              "string",
              "null"
            ]
          },
          "phone": {
            "type": "string"
          },
          "source": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "additionalProperties": false
      },
      "GenderDto": {
        "type": "string",
        "enum": [
          "female",
          "male"
        ]
      },
      "HealthNoteWrite": {
        "type": "object",
        "properties": {
          "health_note": {
            "type": [
              "string",
              "null"
            ],
            "description": "null or empty clears the note."
          }
        },
        "additionalProperties": false
      },
      "LoginBody": {
        "type": "object",
        "required": [
          "phone",
          "password"
        ],
        "properties": {
          "password": {
            "type": "string"
          },
          "phone": {
            "type": "string"
          }
        },
        "additionalProperties": false
      },
      "Me": {
        "type": "object",
        "description": "Body of `GET /me` and of a successful login.",
        "required": [
          "user",
          "tenants",
          "permissions"
        ],
        "properties": {
          "active_tenant": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/TenantSummary"
              },
              {
                "type": "null"
              }
            ]
          },
          "permissions": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "tenants": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/TenantSummary"
            }
          },
          "user": {
            "$ref": "#/components/schemas/UserSummary"
          }
        }
      },
      "PackagePlanDto": {
        "type": "object",
        "required": [
          "id",
          "name",
          "price",
          "active",
          "version",
          "items"
        ],
        "properties": {
          "active": {
            "type": "boolean"
          },
          "gift_note": {
            "type": [
              "string",
              "null"
            ]
          },
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/PackagePlanItemDto"
            }
          },
          "name": {
            "type": "string"
          },
          "price": {
            "type": "integer",
            "format": "int64",
            "description": "đồng"
          },
          "validity_months": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int32"
          },
          "version": {
            "type": "integer",
            "format": "int64",
            "description": "Send back as `If-Match` when updating."
          }
        }
      },
      "PackagePlanItemDto": {
        "type": "object",
        "required": [
          "service_id",
          "sessions",
          "bonus_sessions"
        ],
        "properties": {
          "bonus_sessions": {
            "type": "integer",
            "format": "int32"
          },
          "service_id": {
            "type": "string",
            "format": "uuid"
          },
          "sessions": {
            "type": "integer",
            "format": "int32"
          }
        }
      },
      "PlanItemWrite": {
        "type": "object",
        "required": [
          "service_id",
          "sessions",
          "bonus_sessions"
        ],
        "properties": {
          "bonus_sessions": {
            "type": "integer",
            "format": "int32"
          },
          "service_id": {
            "type": "string",
            "format": "uuid"
          },
          "sessions": {
            "type": "integer",
            "format": "int32"
          }
        },
        "additionalProperties": false
      },
      "PlanWrite": {
        "type": "object",
        "required": [
          "name",
          "price",
          "active",
          "items"
        ],
        "properties": {
          "active": {
            "type": "boolean"
          },
          "gift_note": {
            "type": [
              "string",
              "null"
            ]
          },
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/PlanItemWrite"
            }
          },
          "name": {
            "type": "string"
          },
          "price": {
            "type": "integer",
            "format": "int64",
            "description": "đồng"
          },
          "validity_months": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int32"
          }
        },
        "additionalProperties": false
      },
      "PricesInput": {
        "type": "object",
        "description": "Prices in đồng: either `all`, or `female` and/or `male` (a missing gender = not offered).",
        "properties": {
          "all": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int64"
          },

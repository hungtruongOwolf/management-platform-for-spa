{
  "db_name": "PostgreSQL",
  "query": "SELECT s.id, s.user_id, s.active_tenant_id, s.last_seen_at, s.absolute_expires_at, s.recent_auth_at\n           FROM app.session s JOIN app.user_account u ON u.id = s.user_id\n           WHERE s.token_hash = $1 AND s.revoked_at IS NULL\n             AND now() < s.idle_expires_at AND now() < s.absolute_expires_at\n             AND u.status = 'active'",

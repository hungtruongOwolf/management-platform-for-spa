  "query": "SELECT r.staff_id, r.work_date, r.compliments, r.complaints, r.note\n           FROM app.staff_daily_review r\n           JOIN UNNEST($2::uuid[], $3::date[]) AS c(staff_id, work_date)\n             ON c.staff_id = r.staff_id AND c.work_date = r.work_date\n           WHERE r.tenant_id = $1",

# Secrets — never commit (.env, .env.staging, .envrc, infra/.env.production …); only the documented examples
.env*
!**/.env.example
!**/.env.production.example
/secrets/
/.prodtest/
*.pem
*.key

# Rust
apps/api/target/

# api:spec writes here first, then renames (scripts/api-spec.mjs)
apps/api/openapi.json.tmp-*

# Node
node_modules/
dist/
coverage/
*.tsbuildinfo
.vite/
playwright-report/
test-results/
lighthouse-report/
.lighthouseci/
# E2E run credentials and signed-in browser state (generated per run)
apps/web/e2e/.auth/

# Local Claude settings, scratch and agent worktrees
.claude/settings.local.json
.claude/worktrees/

# OS / editors
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json

# Vercel CLI link (vercel link / deploy)
.vercel

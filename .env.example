# Copy to .env and fill in. Never commit .env.

# API
APP_BIND_ADDR=127.0.0.1:8080
APP_ENV=development            # development | staging | production
RUST_LOG=info,app=debug

# Database (local dev: infra/docker-compose.dev.yml)
# DATABASE_URL: schema owner — used by migrations, sqlx compile-time checks and tests.
DATABASE_URL=postgres://vpyd:vpyd_dev_password@127.0.0.1:5432/vpyd
# APP_DATABASE_URL: runtime role app_rw (row-level security applies). The API never connects as owner.
APP_DATABASE_URL=postgres://app_rw:app_rw_dev_password@127.0.0.1:5432/vpyd

# Allowed browser origin for state-changing requests (CSRF Origin check)
APP_PUBLIC_ORIGIN=http://localhost:5173

# Optional, development only (the API refuses them in staging/production): a looser per-IP API rate
# limit for the local test stack (E2E, Lighthouse set it themselves). Default: 5 rps, burst 60.
# APP_RATE_PER_SECOND=200
# APP_RATE_BURST=2000

# AES-256 key for field encryption (health notes, MFA secrets). 32 random bytes, base64: `openssl rand -base64 32`.
# Losing it makes stored health notes and MFA secrets unreadable — keep it in the secret store and back it up.
APP_DATA_KEY=
